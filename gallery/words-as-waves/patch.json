{
  "name": "Words As Waves",
  "description": "An instrument made of a sentence: each wavetable frame is one word, with letters as harmonic loudness (a quiet, z loud). A slow LFO reads the sentence left to right.",
  "wavetables": {
    "osc_1": {
      "name": "i am a language model",
      "frames": [
        {
          "text": "i"
        },
        {
          "text": "am"
        },
        {
          "text": "a"
        },
        {
          "text": "language"
        },
        {
          "text": "model"
        },
        {
          "text": "and"
        },
        {
          "text": "this"
        },
        {
          "text": "is"
        },
        {
          "text": "my"
        },
        {
          "text": "voice"
        }
      ]
    }
  },
  "lfos": {
    "lfo_1": {
      "shape": "ramp_up"
    }
  },
  "params": {
